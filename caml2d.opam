# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "2D physics simulation in the browser, written in OCaml"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.3"}
  "js_of_ocaml" {>= "6.0"}
  "js_of_ocaml-compiler" {>= "6.0"}
  "js_of_ocaml-ppx" {>= "6.0"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
